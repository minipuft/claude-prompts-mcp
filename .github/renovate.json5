{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  description: "Renovate Bot configuration for automated dependency updates",
  extends: [
    "config:recommended",
    ":configMigration",
    "helpers:pinGitHubActionDigests",
    "abandonments:recommended",
    ":preserveSemverRanges",
    ":maintainLockFilesWeekly",
  ],
  timezone: "UTC",
  baseBranchPatterns: ["main"],
  prConcurrentLimit: 5,
  prCreation: "immediate",
  prHourlyLimit: 2,
  schedule: ["* 0-5 * * 1"],
  updateNotScheduled: false,
  ignorePaths: [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "assets/demos/**",
  ],
  rebaseWhen: "conflicted",
  platformAutomerge: false,
  automerge: false,
  automergeType: "pr",
  automergeStrategy: "squash",
  semanticCommits: "enabled",
  semanticCommitType: "chore",
  semanticCommitScope: "deps",
  commitMessageAction: "update",
  commitMessageTopic: "{{depName}}",
  commitMessageExtra: "to {{#if isPinDigest}}{{{newDigestShort}}}{{else}}{{#if isMajor}}{{prettyNewMajor}}{{else}}{{#if isSingleVersion}}{{prettyNewVersion}}{{else}}{{newValue}}{{/if}}{{/if}}{{/if}}",
  labels: ["dependencies"],
  packageRules: [
    {
      description: "Default dependency PRs remain maintenance-only",
      matchPackageNames: ["*"],
      semanticCommitType: "chore",
    },
    {
      description: "Server runtime dependencies trigger patch releases",
      matchFileNames: ["server/package.json"],
      matchDepTypes: ["dependencies"],
      semanticCommitType: "fix",
      automerge: false,
    },
    {
      description: "Group nonbreaking server runtime updates",
      matchFileNames: ["server/package.json"],
      matchDepTypes: ["dependencies"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "Server runtime dependencies",
    },
    {
      description: "Group nonbreaking development updates",
      matchDepTypes: ["devDependencies"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "Development dependencies",
    },
    {
      description: "Automerge stable nonmajor development updates after a 14-day soak",
      matchDepTypes: ["devDependencies"],
      matchCurrentVersion: "!/^0/",
      matchUpdateTypes: ["minor", "patch", "pin", "digest"],
      minimumReleaseAge: "14 days",
      automerge: true,
      rebaseWhen: "behind-base-branch",
    },
    {
      description: "Isolate major updates for manual review",
      matchUpdateTypes: ["major"],
      groupName: null,
      reviewers: ["minipuft"],
      automerge: false,
      dependencyDashboardApproval: true,
    },
    {
      description: "TypeScript - require manual review",
      matchPackageNames: ["typescript"],
      allowedVersions: "<7.0.0",
      reviewers: ["minipuft"],
      groupName: "TypeScript",
      automerge: false,
      prBodyNotes: [
        "### TypeScript 7 hold — remove `allowedVersions` only when all three boxes tick",
        "",
        "TS 7 is the Go-native compiler. `require('typescript')` exposes **2** symbols instead of 2248 and `lib/` drops from 24MB to 24KB — the JS compiler API moved behind `./unstable/*`. Every tool that does type-aware work has to be rewritten against it, so this is one upstream cause, not three lagging libraries.",
        "",
        "- [ ] `npm view ts-jest peerDependencies.typescript` admits 7 — today `>=4.3 <7`, and it is a hard guard: **no test suite runs at all**",
        "- [ ] `npm view typescript-eslint peerDependencies.typescript` admits 7 — today `<6.1.0` (this also gates TS **6.1**)",
        "- [ ] `npm run validate:arch` prints a NON-ZERO module count — under TS 7 dependency-cruiser cruises **0 modules and exits 0**",
        "",
        "The third one is why this note exists. dependency-cruiser does not fail on an unsupported TypeScript; it can report success over an empty graph — green CI with every layer and cycle rule switched off. `scripts/validate-arch.ts` reads structured JSON and asserts a module floor so that state fails instead of passing, but read the checklist before trusting a green run on a TypeScript major.",
        "",
        "Minor and patch updates within TS 6.x are fine and need none of this.",
      ],
    },
    {
      description: "CLI TypeScript 6 requires a dedicated migration",
      matchPackageNames: ["typescript"],
      matchFileNames: ["cli/package.json"],
      allowedVersions: "<6.0.0",
      reviewers: ["minipuft"],
      groupName: "CLI TypeScript",
      automerge: false,
      prBodyNotes: [
        "### CLI TypeScript 6 hold",
        "",
        "Remove the CLI-specific `<6.0.0` hold only in a dedicated migration where CLI typecheck, build, integration tests, and the full protected matrix pass with TypeScript 6.",
      ],
    },
    {
      description: "MCP SDK - critical dependency",
      matchPackageNames: ["@modelcontextprotocol/sdk"],
      schedule: ["at any time"],
      reviewers: ["minipuft"],
      groupName: "MCP SDK",
      automerge: false,
    },
    {
      description: "Testing frameworks - require validation",
      matchPackageNames: ["jest", "ts-jest", "@types/jest", "@jest/**"],
      groupName: "Testing frameworks",
      automerge: false,
    },
    {
      description: "ESLint and Prettier - require validation",
      matchPackageNames: [
        "eslint",
        "prettier",
        "@eslint/**",
        "typescript-eslint",
        "eslint-config-*",
        "eslint-plugin-*",
        "@commitlint/**",
      ],
      groupName: "Linting and formatting tools",
      automerge: false,
    },
    {
      description: "Build, packaging, and developer-hook tools require manual review",
      matchPackageNames: [
        "@anthropic-ai/mcpb",
        "dependency-cruiser",
        "esbuild",
        "husky",
        "lint-staged",
        "ts-morph",
        "tsx",
      ],
      groupName: "Build and developer tooling",
      automerge: false,
    },
    {
      description: "GitHub Actions - one executable supply-chain boundary",
      matchManagers: ["github-actions"],
      groupName: "GitHub Actions",
      automerge: false,
    },
    {
      description: "repository-standards action - bumped by hand across every reference",
      matchManagers: ["github-actions"],
      matchPackageNames: ["minipuft/repository-standards"],
      enabled: false,
    },
    {
      description: "Pinned Python validation tools",
      matchDatasources: ["pypi"],
      matchPackageNames: ["ruff", "pyrefly", "pytest", "PyYAML"],
      groupName: "Python validation tools",
      automerge: false,
    },
  ],
  vulnerabilityAlerts: {
    enabled: true,
    automerge: false,
    schedule: ["at any time"],
    minimumReleaseAge: null,
    addLabels: ["security", "vulnerability"],
  },
  dependencyDashboard: {
    enabled: true,
    title: "📦 Dependency Updates Dashboard",
    header: "This dashboard tracks all pending dependency updates. Vulnerability alerts run immediately; regular updates and lock maintenance run Mondays from 00:00 through 05:59 UTC.",
  },
  dependencyDashboardApproval: false,
  minimumReleaseAge: "3 days",
  internalChecksFilter: "strict",
  ignoreDeps: [],
  ignoreTests: false,
  lockFileMaintenance: {
    enabled: true,
    schedule: ["* 0-5 * * 1"],
    minimumReleaseAge: "3 days",
    minimumReleaseAgeBehaviour: "timestamp-optional",
    automerge: true,
    rebaseWhen: "behind-base-branch",
    commitMessageAction: "refresh",
  },
  prBodyTemplate: "{{{header}}}{{{table}}}{{{notes}}}{{{changelogs}}}{{{configDescription}}}{{{controls}}}{{{footer}}}",
  prBodyColumns: ["Package", "Update", "Type", "Change", "Pending"],
  branchPrefix: "renovate/",
  branchConcurrentLimit: 10,
  respectLatest: true,
  customManagers: [
    {
      customType: "regex",
      description: "Pinned Renovate version in its validator workflow",
      managerFilePatterns: [
        "/^\\.github\\/workflows\\/renovate-config-validator\\.yml$/",
      ],
      matchStrings: [
        "npm install -g renovate@(?<currentValue>[0-9][^\\s\"']*)",
      ],
      depNameTemplate: "renovate",
      datasourceTemplate: "npm",
    },
  ],
}
