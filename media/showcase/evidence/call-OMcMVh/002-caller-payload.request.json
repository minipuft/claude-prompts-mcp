{
  "name": "resource_manager",
  "arguments": {
    "resource_type": "prompt",
    "action": "create",
    "id": "animation_animatic",
    "name": "Animation Animatic (per episode)",
    "category": "animation",
    "description": "Per episode, between pre-production and the per-shot chain (D80): timeline → blocking → light script → animatic render → rubric grade → evidence. Each step carries a check-tier gate that runs a probe with a positive control (D81); the grade step is the one advisory gate and says so. Inputs: episode_root, renderer, output_root.",
    "arguments": [
      {
        "name": "episode_root",
        "type": "string",
        "required": true,
        "description": "Episode directory holding the beat ledger (beats-v2.json or beats.json), contracts (timeline.json, blocking/, keys/, light.json, worlds/), rubric.md and studies/ (e.g. media/showcase/v3)."
      },
      {
        "name": "renderer",
        "type": "string",
        "required": false,
        "defaultValue": "media/showcase",
        "description": "The rendering project root (Remotion here): where `npm run animatic`, `npm run xsheet` and scripts/animation/ live."
      },
      {
        "name": "context",
        "type": "string",
        "required": false,
        "description": "Owner notes, rulings or the previous step's result."
      },
      {
        "name": "output_root",
        "type": "string",
        "required": false,
        "defaultValue": "media/showcase",
        "description": "Caller-owned production artifact directory for studies and receipts."
      },
      {
        "name": "brief",
        "type": "string",
        "required": false,
        "description": "One paragraph: what this animatic must answer for the owner (pacing, a world, a crossing)."
      }
    ],
    "chain_steps": [
      {
        "id": "timeline",
        "stepName": "Timeline",
        "promptId": "animation_timeline",
        "inputMapping": {
          "episode_root": "episode_root",
          "renderer": "renderer",
          "context": "brief",
          "output_root": "output_root"
        },
        "inlineGateIds": [
          "animation-timeline-contract"
        ]
      },
      {
        "id": "blocking",
        "stepName": "Blocking",
        "promptId": "animation_blocking",
        "inputMapping": {
          "episode_root": "episode_root",
          "renderer": "renderer",
          "context": "previous_step_result",
          "output_root": "output_root"
        },
        "inlineGateIds": [
          "animation-blocking-contract"
        ]
      },
      {
        "id": "light",
        "stepName": "Light and Colour Script",
        "promptId": "animation_light_script",
        "inputMapping": {
          "episode_root": "episode_root",
          "renderer": "renderer",
          "context": "previous_step_result",
          "output_root": "output_root"
        },
        "inlineGateIds": [
          "animation-colour-script"
        ]
      },
      {
        "id": "render",
        "stepName": "Animatic Render",
        "promptId": "animation_animatic_render",
        "inputMapping": {
          "episode_root": "episode_root",
          "renderer": "renderer",
          "context": "previous_step_result",
          "output_root": "output_root"
        },
        "inlineGateIds": [
          "animation-animatic-probes"
        ]
      },
      {
        "id": "grade",
        "stepName": "Rubric Grade",
        "promptId": "showcase_review",
        "inputMapping": {
          "brief": "brief",
          "constraints": "episode_root",
          "context": "previous_step_result",
          "output_root": "output_root"
        },
        "inlineGateIds": [
          "animation-review"
        ]
      },
      {
        "id": "evidence",
        "stepName": "File and Feed Back",
        "promptId": "showcase_evidence",
        "inputMapping": {
          "brief": "brief",
          "shot": "episode_root",
          "context": "previous_step_result",
          "output_root": "output_root"
        },
        "inlineGateIds": [
          "handoff-artifacts"
        ]
      }
    ]
  }
}
