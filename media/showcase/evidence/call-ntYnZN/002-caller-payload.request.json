{
  "name": "resource_manager",
  "arguments": {
    "resource_type": "prompt",
    "action": "create",
    "id": "showcase_preproduction",
    "name": "Showcase Pre-production",
    "category": "development",
    "description": "Once per episode: rebuild the board, write the story and beats, break them into shots with the object inventory, and grade the package; the muse then runs per object from the inventory (showcase_asset_muse) before any showcase_shot run.",
    "arguments": [
      {
        "name": "brief",
        "type": "string",
        "required": true,
        "description": "Audience, product goal and desired silent showcase outcome."
      },
      {
        "name": "constraints",
        "type": "string",
        "required": false,
        "defaultValue": "~40 s at 30 fps, 1280x720, silent, poster at frame 0, swangle renderer here, final render on the Windows host.",
        "description": "Duration, dimensions, renderer and evidence limits."
      },
      {
        "name": "output_root",
        "type": "string",
        "required": false,
        "defaultValue": "media/showcase",
        "description": "Caller-owned production artifact directory."
      }
    ],
    "chain_steps": [
      {
        "id": "board",
        "promptId": "showcase_board",
        "stepName": "Board",
        "inputMapping": {
          "brief": "brief",
          "output_root": "output_root"
        }
      },
      {
        "id": "story",
        "promptId": "showcase_story",
        "stepName": "Story and Beats",
        "inputMapping": {
          "brief": "brief",
          "constraints": "constraints",
          "context": "previous_step_result",
          "output_root": "output_root"
        }
      },
      {
        "id": "shots",
        "promptId": "showcase_shotlist",
        "stepName": "Shot List and Inventory",
        "inputMapping": {
          "brief": "brief",
          "constraints": "constraints",
          "context": "previous_step_result",
          "output_root": "output_root"
        }
      },
      {
        "id": "grade",
        "promptId": "showcase_review",
        "stepName": "Package Grade",
        "inputMapping": {
          "brief": "brief",
          "constraints": "constraints",
          "context": "previous_step_result",
          "output_root": "output_root"
        },
        "inlineGateIds": [
          "showcase-review"
        ]
      }
    ],
    "artifacts": {
      "produces": [
        "docs",
        "plan"
      ]
    }
  }
}
