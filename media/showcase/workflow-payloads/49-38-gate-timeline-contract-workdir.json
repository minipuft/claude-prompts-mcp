{
  "name": "resource_manager",
  "arguments": {
    "resource_type": "gate",
    "action": "update",
    "id": "animation-timeline-contract",
    "pass_criteria": [
      {
        "type": "shell_verify",
        "shell_command": [
          "python3",
          "scripts/animation/probe-timeline.py",
          "v3/timeline.json"
        ],
        "shell_working_dir": "../media/showcase",
        "shell_timeout": 600000,
        "shell_max_attempts": 1,
        "shell_preset": "full"
      }
    ]
  }
}
