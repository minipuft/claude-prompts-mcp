{
  "name": "resource_manager",
  "arguments": {
    "resource_type": "gate",
    "action": "update",
    "id": "animation-animatic-probes",
    "pass_criteria": [
      {
        "type": "shell_verify",
        "shell_command": [
          "python3",
          "scripts/animation/probe-all.py",
          "out/animatic-seq",
          "--timeline",
          "v3/timeline.json",
          "--xsheet",
          "v3/xsheet.json",
          "--second-frames",
          "out/animatic-seq-b",
          "--subset"
        ],
        "shell_working_dir": "../media/showcase",
        "shell_timeout": 600000,
        "shell_max_attempts": 1,
        "shell_preset": "full"
      }
    ]
  }
}
