{
  "name": "resource_manager",
  "arguments": {
    "resource_type": "prompt",
    "action": "update",
    "id": "showcase_shot",
    "description": "Once per shot (D72 pose-to-pose, D83 pose-first): cinematography sheet, timing chart with the key list, the pose sheet (every key a curve the solver builds, breakdowns that are poses, secondaries that lag, moving holds) behind the pose gate, the key sheet generated from the model sheet and the pose sheet and cut into key plates per family, the render study (Remotion, or Blender when tool:blender_render is named) behind the inbetween probes, the rubric grade behind the showcase-review gate, and the evidence step that files the receipt and feeds the measured range back into shots.json and the script.",
    "arguments": [
      {
        "name": "shot",
        "type": "string",
        "description": "Shot id from v3/shots.json.",
        "required": true
      },
      {
        "name": "brief",
        "type": "string",
        "description": "Audience, product goal and desired silent showcase outcome.",
        "required": false,
        "defaultValue": "Silent showcase film for Claude Prompts MCP; see v3/script.md."
      },
      {
        "name": "renderer",
        "type": "string",
        "description": "remotion or blender (blender also needs tool:blender_render on the request).",
        "required": false,
        "defaultValue": "remotion",
        "validation": {
          "allowedValues": [
            "remotion",
            "blender"
          ]
        }
      },
      {
        "name": "frames",
        "type": "string",
        "description": "Frame set the render study produces.",
        "required": false,
        "defaultValue": "first,key,last,strip"
      },
      {
        "name": "constraints",
        "type": "string",
        "description": "Renderer and evidence limits.",
        "required": false,
        "defaultValue": "1280x720 at 30 fps, swangle here; the camera follows the layout contract (D64, D77); one emitter at a time; drawn on twos, light on ones; every key a pose on one curve, every breakdown a pose, never a favour alone (D83)."
      },
      {
        "name": "output_root",
        "type": "string",
        "description": "Caller-owned production artifact directory.",
        "required": false,
        "defaultValue": "media/showcase"
      }
    ],
    "chain_steps": [
      {
        "id": "layout",
        "stepName": "Cinematography Sheet",
        "promptId": "showcase_layout_sheet",
        "inputMapping": {
          "shot": "shot",
          "output_root": "output_root"
        }
      },
      {
        "id": "motion",
        "stepName": "Timing Table",
        "promptId": "showcase_motion",
        "inputMapping": {
          "brief": "brief",
          "constraints": "constraints",
          "context": "previous_step_result",
          "output_root": "output_root"
        }
      },
      {
        "id": "poses",
        "stepName": "Pose Sheet",
        "promptId": "animation_poses",
        "inputMapping": {
          "shot": "shot",
          "context": "previous_step_result",
          "output_root": "output_root"
        },
        "inlineGateIds": [
          "animation-pose-contract"
        ]
      },
      {
        "id": "keys",
        "stepName": "Key Sheet",
        "promptId": "showcase_key_sheet",
        "inputMapping": {
          "shot": "shot",
          "context": "previous_step_result",
          "output_root": "output_root"
        },
        "delegated": true
      },
      {
        "id": "render",
        "stepName": "Render Study",
        "promptId": "showcase_render_study",
        "inputMapping": {
          "brief": "brief",
          "shot": "shot",
          "renderer": "renderer",
          "frames": "frames",
          "context": "previous_step_result",
          "output_root": "output_root"
        },
        "inlineGateIds": [
          "animation-inbetween-probes"
        ]
      },
      {
        "id": "grade",
        "stepName": "Rubric Grade",
        "promptId": "showcase_review",
        "inputMapping": {
          "brief": "brief",
          "constraints": "constraints",
          "context": "previous_step_result",
          "motion_contract": "step2_result",
          "output_root": "output_root"
        },
        "inlineGateIds": [
          "showcase-review"
        ]
      },
      {
        "id": "evidence",
        "stepName": "File and Feed Back",
        "promptId": "showcase_evidence",
        "inputMapping": {
          "brief": "brief",
          "shot": "shot",
          "context": "previous_step_result",
          "output_root": "output_root"
        }
      }
    ]
  }
}