{
  "name": "claude-prompts-showcase-trial",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Private, silent editorial animation trial; no server runtime dependency.",
  "scripts": {
    "studio": "remotion studio src/index.ts --port=3107",
    "typecheck": "tsc --noEmit",
    "compositions": "remotion compositions src/index.ts",
    "render:proof": "remotion render src/index.ts Showcase out/renderer-proof.mp4 --frames=0-599 --codec=h264 --scale=0.6666666666666666 --crf=18 --concurrency=4",
    "render:full": "remotion render src/index.ts Showcase out/showcase-draft.mp4 --codec=h264 --scale=0.6666666666666666 --crf=18 --concurrency=4",
    "still": "remotion still src/index.ts Showcase",
    "board": "node scripts/build-board.mjs --png 9000",
    "check:animation-boundary": "node scripts/animation/check-boundary.mjs",
    "timeline": "node scripts/animation/compile-timeline.mjs",
    "light": "node scripts/animation/compile-light.mjs",
    "roles": "node scripts/animation/compile-roles.mjs",
    "animatic": "remotion render src/index.ts Animatic65 out/animatic-01.mp4 --codec=h264 --scale=0.5 --concurrency=4",
    "xsheet": "node scripts/animation/xsheet.mjs",
    "joints": "node scripts/animation/joints.mjs",
    "check:pose": "node scripts/animation/check-pose.mjs",
    "solve-poses": "node scripts/animation/solve-poses.mjs",
    "plates": "node scripts/animation/plates-from-poses.mjs",
    "parts": "node scripts/animation/cut-parts.mjs",
    "render": "node scripts/animation/render-cached.mjs",
    "render:manifest": "node scripts/animation/render-manifest.mjs",
    "film-keys": "remotion render src/index.ts KeyFilmS01 out/s01-arrival-overwhelm-key-film --sequence --image-format=png --concurrency=4",
    "eagle:sync": "python3 $HOME/.claude/skills/inspiration/scripts/eagle_board.py sync --out v3/references/owner",
    "eagle:watch": "python3 $HOME/.claude/skills/inspiration/scripts/eagle_board.py watch --out v3/references/owner",
    "eagle:serve": "python3 -m http.server 3108 --directory v3/references/owner"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.1",
    "@remotion/cli": "4.0.530",
    "@remotion/fonts": "4.0.530",
    "@remotion/three": "^4.0.530",
    "@types/three": "^0.186.0",
    "earcut": "^3.2.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.530",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
