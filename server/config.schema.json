{
  "$id": "https://github.com/minipuft/claude-prompts-mcp/server/config.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference for IDE validation."
    },
    "version": {
      "type": "number",
      "const": 5,
      "description": "Config file format version. `5` is the shape this file describes; an older file declares its own version and is migrated before it reaches this type."
    },
    "server": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Server name reported to MCP clients.",
          "default": "claude-prompts"
        },
        "port": {
          "type": "integer",
          "description": "Port for the Streamable HTTP transport (ignored for stdio).",
          "default": 9090,
          "minimum": 1024,
          "maximum": 65535
        }
      },
      "additionalProperties": false,
      "description": "Server identity and transport settings."
    },
    "prompts": {
      "type": "object",
      "properties": {
        "directory": {
          "type": "string",
          "description": "Directory containing prompt definitions (relative to server root).",
          "default": "resources/prompts"
        },
        "registerWithMcp": {
          "type": "boolean",
          "description": "Register prompts as MCP resources for client discovery.",
          "default": true
        }
      },
      "additionalProperties": false,
      "description": "Prompt loading and registration."
    },
    "identity": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "permissive",
            "locked"
          ],
          "description": "Identity precedence mode.",
          "default": "permissive"
        },
        "allowPerRequestOverride": {
          "type": "boolean",
          "description": "Allow request claims to override launch defaults based on transport policy.",
          "default": true
        },
        "launchDefaults": {
          "type": "object",
          "properties": {
            "organizationId": {
              "type": "string",
              "description": "Default organization scope."
            },
            "workspaceId": {
              "type": "string",
              "description": "Default workspace scope."
            },
            "clientFamily": {
              "type": "string",
              "enum": [
                "claude-code",
                "codex",
                "gemini",
                "opencode",
                "cursor",
                "unknown"
              ],
              "description": "Authoritative launch-level client family for delegation routing."
            },
            "clientId": {
              "type": "string",
              "description": "Authoritative launch-level client identifier."
            },
            "clientVersion": {
              "type": "string",
              "description": "Authoritative launch-level client version."
            },
            "delegationProfile": {
              "type": "string",
              "enum": [
                "task_tool_v1",
                "spawn_agent_v1",
                "gemini_subagent_v1",
                "opencode_agent_v1",
                "cursor_agent_v1",
                "neutral_v1"
              ],
              "description": "Authoritative launch-level delegation profile."
            }
          },
          "additionalProperties": false,
          "description": "Launch-time defaults used when request identity/profile metadata is missing."
        }
      },
      "additionalProperties": false,
      "description": "Identity and client-profile resolution for scope isolation and delegation routing."
    },
    "frameworks": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable framework system.",
          "default": true
        },
        "dynamicToolDescriptions": {
          "type": "boolean",
          "description": "Adapt MCP tool descriptions based on active framework.",
          "default": true
        },
        "defaultFramework": {
          "type": "string",
          "description": "Framework a scope falls back to when it has no persisted state row. Set per project to pin a repo to one framework (e.g. 'RADIANT' for design work). A runtime framework switch overrides this for that scope and persists.",
          "default": "CAGEERF"
        },
        "injection": {
          "type": "object",
          "properties": {
            "systemPrompt": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Inject framework system-prompt guidance at all.",
                  "default": true
                },
                "frequency": {
                  "type": "integer",
                  "description": "Inject framework guidance every N chain steps. Higher values reduce token usage at the cost of less frequent framework reinforcement.",
                  "default": 3,
                  "minimum": 1,
                  "maximum": 100
                },
                "target": {
                  "type": "string",
                  "enum": [
                    "steps",
                    "gates",
                    "both"
                  ],
                  "description": "Where to inject framework guidance: 'steps' (normal execution), 'gates' (gate reviews), or 'both'.",
                  "default": "steps"
                }
              },
              "additionalProperties": false,
              "description": "System prompt injection settings."
            },
            "gateGuidance": {
              "type": "object",
              "properties": {
                "frequency": {
                  "type": "integer",
                  "description": "Inject gate criteria every N chain steps. 0 = first step only. Gate review steps always receive guidance regardless of this setting.",
                  "default": 0,
                  "minimum": 0,
                  "maximum": 100
                },
                "target": {
                  "type": "string",
                  "enum": [
                    "steps",
                    "gates",
                    "both"
                  ],
                  "description": "Where to inject gate criteria: 'steps' (normal execution), 'gates' (gate reviews), or 'both'.",
                  "default": "both"
                }
              },
              "additionalProperties": false,
              "description": "Gate guidance injection settings."
            },
            "styleGuidance": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Include response formatting guidance in prompts.",
                  "default": true
                },
                "frequency": {
                  "type": "integer",
                  "description": "Inject style guidance every N chain steps. 0 = first step only. Set to 1 for every step.",
                  "default": 0,
                  "minimum": 0,
                  "maximum": 100
                },
                "target": {
                  "type": "string",
                  "enum": [
                    "steps",
                    "gates",
                    "both"
                  ],
                  "description": "Where to inject style guidance: 'steps' (normal execution), 'gates' (gate reviews), or 'both'.",
                  "default": "steps"
                }
              },
              "additionalProperties": false,
              "description": "Style guidance injection settings."
            }
          },
          "additionalProperties": false,
          "description": "Injection control for framework content."
        }
      },
      "additionalProperties": false,
      "description": "Frameworks (CAGEERF, ReACT, etc.) that guide LLM behavior."
    },
    "gates": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable the gate validation system.",
          "default": true
        },
        "frameworkGates": {
          "type": "boolean",
          "description": "Apply framework-specific quality gates.",
          "default": true
        },
        "executeInlineGateDefinitions": {
          "type": "boolean",
          "description": "Execute a prompt's gateConfiguration.inline_gate_definitions block instead of only displaying it. Off by default this release so an operator can watch the 'Dropped inline gate definition' warnings and see which workspace prompts would newly arm a gate; set true to opt in early. The next release makes true the default.",
          "default": false
        },
        "evaluation": {
          "type": "object",
          "properties": {
            "defaultMode": {
              "type": "string",
              "enum": [
                "self",
                "judge"
              ],
              "description": "Default evaluation mode for all gates: 'self' (same-context review) or 'judge' (context-isolated delegation).",
              "default": "self"
            },
            "defaultModel": {
              "type": "string",
              "description": "Default model hint for judge sub-agents (e.g., 'haiku' for cheap evaluation)."
            },
            "strict": {
              "type": "boolean",
              "description": "Default strict mode: use failure-first framing for judge evaluation.\n\nAbsent, its effective default is not a constant: `resolveJudgeConfig` (`judge-prompt-builder.ts`) falls back to `true` exactly when the evaluation mode is `'judge'`, and to `false` otherwise."
            }
          },
          "additionalProperties": false,
          "description": "Judge evaluation defaults."
        },
        "harnessCovers": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "A reminder subject an installation's harness already covers. Spellings are copied from the Subject column of `resources/gates/_index.md`.",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "description": "Reminder subjects this installation's harness already covers (its own rules or hooks). A reminder gate whose `subject` is listed is not rendered; checks are never suppressed.",
          "default": []
        },
        "reminderTokenBudget": {
          "type": "integer",
          "description": "Estimated tokens of reminder guidance rendered per dispatch. Reminders over the budget render as one line each, in priority order; nothing is dropped. Checks are outside the budget.",
          "default": 800,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "description": "Quality gates for validating LLM outputs."
    },
    "verification": {
      "type": "object",
      "properties": {
        "inContextAttempts": {
          "type": "integer",
          "description": "Fix attempts within current context before spawning isolation. Set to 0 for immediate isolation.",
          "default": 3,
          "minimum": 0,
          "maximum": 10
        },
        "isolation": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable spawning isolated Claude instances after in-context attempts fail.",
              "default": true
            },
            "maxBudget": {
              "type": "number",
              "description": "Maximum cost (USD) per isolation spawn.",
              "default": 1,
              "minimum": 0.01,
              "maximum": 10
            },
            "timeout": {
              "type": "integer",
              "description": "Timeout in seconds for each isolation spawn.",
              "default": 300,
              "minimum": 30,
              "maximum": 3600
            },
            "permissionMode": {
              "type": "string",
              "enum": [
                "delegate",
                "ask",
                "deny"
              ],
              "description": "How spawned instance handles permission requests.",
              "default": "delegate"
            }
          },
          "additionalProperties": false,
          "description": "Context isolation settings."
        }
      },
      "additionalProperties": false,
      "description": "Ralph Loops: autonomous verification via shell commands."
    },
    "versioning": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Track prompt versions.",
          "default": true
        },
        "autoVersion": {
          "type": "boolean",
          "description": "Auto-create versions on prompt changes.",
          "default": true
        },
        "maxVersions": {
          "type": "integer",
          "description": "Maximum versions to retain per prompt.",
          "default": 50,
          "minimum": 1,
          "maximum": 500
        }
      },
      "additionalProperties": false,
      "description": "Prompt version control."
    },
    "phaseGuards": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "enforce",
            "warn",
            "off"
          ],
          "description": "Enforcement mode: 'enforce' blocks advancement until structural requirements pass, 'warn' logs advisory warnings, 'off' disables phase guards.",
          "default": "enforce"
        },
        "maxRetries": {
          "type": "integer",
          "description": "Maximum retry attempts before phase guard review expires (enforce mode only).",
          "default": 2,
          "minimum": 0,
          "maximum": 10
        }
      },
      "additionalProperties": false,
      "description": "Deterministic structural validation of LLM output against framework phase definitions."
    },
    "execution": {
      "type": "object",
      "properties": {
        "judge": {
          "type": "boolean",
          "description": "Enable %judge modifier for framework comparison.",
          "default": true
        }
      },
      "additionalProperties": false,
      "description": "Prompt execution behavior."
    },
    "hooks": {
      "type": "object",
      "properties": {
        "expandedOutput": {
          "type": "boolean",
          "description": "Show detailed multi-line output instead of compact single-line. Useful for debugging or verbose mode. An absent key resolves to `false` in `hooks/lib/config_loader.py`.",
          "default": true
        }
      },
      "additionalProperties": false,
      "description": "Claude Code hook behavior (affects prompt-suggest.py output)."
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Master switch for the telemetry subsystem. When false, no OTel SDK is initialized.",
          "default": false
        },
        "mode": {
          "type": "string",
          "enum": [
            "off",
            "traces",
            "full"
          ],
          "description": "Export mode: 'off' (disabled), 'traces' (spans/events only), 'full' (spans + OTel metrics).",
          "default": "off"
        },
        "exporterEndpoint": {
          "type": "string",
          "description": "OTLP HTTP exporter endpoint URL.",
          "default": "http://localhost:4318"
        },
        "samplingRate": {
          "type": "number",
          "description": "Head sampling rate for traces (0.0-1.0). 1.0 = sample everything, 0.0 = sample nothing.",
          "default": 1,
          "minimum": 0,
          "maximum": 1
        },
        "attributePolicy": {
          "type": "object",
          "properties": {
            "businessContext": {
              "type": "boolean",
              "description": "Include safe business-context attributes (cpm.prompt.id, cpm.execution.mode, etc.).",
              "default": true
            },
            "rawCommands": {
              "type": "boolean",
              "description": "Include raw command text in traces. WARNING: may contain sensitive data.",
              "default": false
            },
            "rawResponses": {
              "type": "boolean",
              "description": "Include raw user responses in traces. WARNING: may contain sensitive data.",
              "default": false
            },
            "allowlist": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Custom attribute names to explicitly include in traces."
            }
          },
          "additionalProperties": false,
          "description": "Controls which attributes are included in trace spans and events for data safety."
        }
      },
      "additionalProperties": false,
      "description": "OpenTelemetry observability: tracing, metrics, and attribute policy."
    },
    "logging": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug"
          ],
          "description": "Minimum log level.",
          "default": "info"
        },
        "directory": {
          "type": "string",
          "description": "Log file directory.",
          "default": "./logs"
        }
      },
      "additionalProperties": false,
      "description": "Server logging configuration."
    },
    "resources": {
      "type": "object",
      "properties": {
        "registerWithMcp": {
          "type": "boolean",
          "description": "Master switch: register resources with MCP protocol (default: false for token efficiency).",
          "default": false
        },
        "prompts": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable this resource family.",
              "default": true
            }
          },
          "additionalProperties": false,
          "description": "Prompt resources (resource://prompt/...)."
        },
        "gates": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable this resource family.",
              "default": true
            }
          },
          "additionalProperties": false,
          "description": "Gate resources (resource://gate/...)."
        },
        "frameworks": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable this resource family.",
              "default": true
            }
          },
          "additionalProperties": false,
          "description": "Framework resources (resource://framework/...)."
        },
        "observability": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable observability resources.",
              "default": true
            },
            "sessions": {
              "type": "boolean",
              "description": "Enable session resources (resource://session/...).",
              "default": true
            },
            "metrics": {
              "type": "boolean",
              "description": "Enable metrics resources (resource://metrics/...).",
              "default": true
            }
          },
          "additionalProperties": false,
          "description": "Observability resources (sessions and metrics)."
        },
        "logs": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable logs resource (resource://logs/).",
              "default": true
            },
            "maxEntries": {
              "type": "integer",
              "description": "Maximum log entries to retain in memory.",
              "default": 500,
              "minimum": 50,
              "maximum": 5000
            },
            "defaultLevel": {
              "type": "string",
              "enum": [
                "error",
                "warn",
                "info",
                "debug"
              ],
              "description": "Minimum level to buffer (entries below this level are not stored).",
              "default": "info"
            }
          },
          "additionalProperties": false,
          "description": "Logs resource for debugging and observability."
        }
      },
      "additionalProperties": false,
      "description": "MCP resources configuration."
    },
    "chainSessions": {
      "type": "object",
      "properties": {
        "timeoutMinutes": {
          "type": "integer",
          "description": "Idle session timeout in minutes (default: 24 hours).",
          "default": 1440,
          "minimum": 1,
          "maximum": 10080
        },
        "reviewTimeoutMinutes": {
          "type": "integer",
          "description": "Gate review timeout in minutes.",
          "default": 30,
          "minimum": 1,
          "maximum": 10080
        },
        "cleanupIntervalMinutes": {
          "type": "integer",
          "description": "Background cleanup frequency in minutes.",
          "default": 5,
          "minimum": 1,
          "maximum": 10080
        }
      },
      "additionalProperties": false,
      "description": "Chain session lifecycle management."
    }
  },
  "required": [
    "version"
  ],
  "additionalProperties": false,
  "description": "The contents of a 5.0 `config.json`.\n\nEvery section is optional; `version` is not, because the loader routes on it and a file that does not say which shape it is written in cannot be read as either.",
  "definitions": {}
}
