{
  "framework_builder": {
    "emitsResourceManagerCall": false,
    "input": {
      "id": "probe-framework",
      "name": "Probe Framework",
      "enabled": false,
      "description": "A framework used only to exercise the builder's output mapping.",
      "system_prompt_guidance": "Apply the PROBE framework systematically:\n\n**Phase1**: Do the 1th thing thoroughly and record what it produced.\n**Phase2**: Do the 2th thing thoroughly and record what it produced.\n**Phase3**: Do the 3th thing thoroughly and record what it produced.",
      "phases": [
        {
          "id": "phase_one",
          "name": "Phase One",
          "description": "Establish the ground facts"
        },
        {
          "id": "phase_two",
          "name": "Phase Two",
          "description": "Act on the ground facts"
        }
      ],
      "gates": {
        "include": ["framework-compliance"]
      },
      "framework_gates": [
        {
          "id": "phase_one_quality",
          "name": "Phase One Quality",
          "description": "Verify phase one",
          "frameworkArea": "phase_one",
          "priority": "high",
          "validationCriteria": ["a", "b"]
        },
        {
          "id": "phase_two_quality",
          "name": "Phase Two Quality",
          "description": "Verify phase two",
          "frameworkArea": "phase_two",
          "priority": "high",
          "validationCriteria": ["a", "b"]
        }
      ],
      "framework_elements": {
        "requiredSections": ["Ground Facts", "Actions"],
        "sectionDescriptions": {
          "Ground Facts": "What is true",
          "Actions": "What to do",
          "Findings": "What resulted"
        }
      },
      "argument_suggestions": [
        {
          "name": "topic",
          "description": "What to probe",
          "frameworkReason": "Phase One needs a subject",
          "type": "string"
        },
        {
          "name": "depth",
          "description": "How far to probe",
          "frameworkReason": "Phase Two needs a bound",
          "type": "string"
        }
      ],
      "template_suggestions": [
        {
          "type": "structure",
          "section": "user",
          "description": "Report template",
          "content": "Record the findings",
          "frameworkJustification": "Phase Two output shape",
          "impact": "high"
        }
      ],
      "processing_steps": [
        {
          "id": "s1",
          "name": "S1",
          "description": "d",
          "frameworkBasis": "PROBE Phase 1",
          "order": 1,
          "required": true
        },
        {
          "id": "s2",
          "name": "S2",
          "description": "d",
          "frameworkBasis": "PROBE Phase 2",
          "order": 2,
          "required": true
        },
        {
          "id": "s3",
          "name": "S3",
          "description": "d",
          "frameworkBasis": "PROBE Phase 2",
          "order": 3,
          "required": false
        }
      ],
      "execution_steps": [
        {
          "id": "e1",
          "name": "E1",
          "dependencies": [],
          "expected_output": "o1",
          "frameworkPhase": "phase_one",
          "action": "Record E1 evidence"
        },
        {
          "id": "e2",
          "name": "E2",
          "dependencies": ["e1"],
          "expected_output": "o2",
          "frameworkPhase": "phase_one",
          "action": "Record E2 evidence"
        },
        {
          "id": "e3",
          "name": "E3",
          "dependencies": ["e2"],
          "expected_output": "o3",
          "frameworkPhase": "phase_one",
          "action": "Record E3 evidence"
        }
      ],
      "tool_descriptions": {
        "prompt_engine": {
          "description": "Runs the probe."
        }
      },
      "quality_indicators": {
        "phase_one": {
          "keywords": ["ground"],
          "patterns": ["ground .*"]
        },
        "phase_two": {
          "keywords": ["action"],
          "patterns": ["action .*"]
        }
      },
      "execution_flow": {
        "preProcessingSteps": ["e1"],
        "postProcessingSteps": ["e3"],
        "validationSteps": ["e2"]
      },
      "judge_prompt": "Judge whether both phases were carried out and recorded.",
      "template_enhancements": {
        "systemPromptAdditions": ["Record evidence"],
        "userPromptModifications": ["Include findings"],
        "contextualHints": ["Probe only"]
      },
      "execution_type_enhancements": {
        "chain": "Carry ground facts between steps."
      }
    }
  },
  "gate_builder": {
    "emitsResourceManagerCall": false,
    "input": {
      "id": "probe-gate",
      "name": "Probe Gate",
      "type": "validation",
      "description": "A gate used only to exercise the builder's output mapping",
      "guidance": "Check that the probe recorded what it observed.",
      "severity": "high",
      "pass_criteria": [
        {
          "type": "inline_guidance"
        }
      ],
      "retry_config": {
        "maxRetries": 1
      },
      "activation": {
        "artifacts": ["plan"]
      },
      "enforcement_mode": "advisory",
      "gate_type": "custom",
      "subject": "probe-output",
      "block_response_on_fail": false,
      "evaluation": {
        "mode": "self",
        "strict": false
      }
    }
  },
  "prompt_builder": {
    "emitsResourceManagerCall": true,
    "input": {
      "id": "probe_prompt",
      "name": "Probe Prompt",
      "category": "examples",
      "description": "A prompt used only to exercise the builder's output mapping",
      "arguments": [
        {
          "name": "topic",
          "description": "what to probe"
        }
      ],
      "tools": [],
      "system_message": "You are a probe.",
      "user_message_template": "Probe {{topic}}",
      "gate_configuration": {
        "include": ["framework-compliance"]
      },
      "chain_steps": [
        {
          "promptId": "probe_prompt/research",
          "stepName": "Research",
          "id": "research",
          "args": {
            "topic": "probe",
            "count": 0,
            "enabled": false,
            "details": {}
          },
          "inlineGateIds": ["research-quality"],
          "inlineGateCriteria": ["Record source evidence"],
          "inputMapping": {
            "topic": "topic"
          },
          "outputMapping": {
            "result": "research_result"
          },
          "visibility": {
            "expose": ["previous_step_output"],
            "withhold": ["chain_history"]
          },
          "delegated": true,
          "subagentModel": "fast",
          "agentType": "researcher",
          "await": "node",
          "retries": 0,
          "framework": "ReACT"
        },
        {
          "promptId": "probe_prompt/review",
          "stepName": "Review",
          "id": "review",
          "args": {},
          "delegated": false,
          "await": "run"
        }
      ],
      "register_with_mcp": false,
      "mcp_prompt_mode": "launch",
      "subagent_model": "standard",
      "agent_type": "researcher",
      "edges": [
        {
          "from": "research",
          "to": "review"
        }
      ],
      "budget": {
        "maxNodes": 2,
        "maxFanOut": 1,
        "maxInsertions": 0,
        "declaredCostCeiling": 1,
        "pauseOnBlocking": false
      },
      "artifacts": {
        "produces": ["prompt", "docs"],
        "fromArgument": "topic"
      },
      "composer": {
        "inputArgument": "topic"
      },
      "injection": {
        "system-prompt": {
          "enabled": false,
          "frequency": {
            "mode": "never"
          },
          "target": "steps"
        }
      }
    }
  },
  "text_digest": {
    "emitsResourceManagerCall": false,
    "input": {
      "text": "probe"
    }
  },
  "word_count": {
    "emitsResourceManagerCall": false,
    "input": {
      "text": "probe text"
    }
  }
}
