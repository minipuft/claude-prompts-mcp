    "system_control": {
      "description": "⚙️ SYSTEM CONTROL: Retrieves system status, switches frameworks, manages gates, and provides analytics.\n\nACTIONS: status | framework | gates | analytics | config | maintenance | guide | injection | session | changes | execution_history | skills_sync\n\nReturns: Current state, configurations, or operation confirmations.",
      "shortDescription": "System administration",
