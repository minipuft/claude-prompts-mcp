{
  "name": "claude-prompts",
  "version": "4.0.1",
  "mcpName": "io.github.minipuft/claude-prompts-mcp",
  "description": "Model Context Protocol (MCP) server for reusable prompt templates, multi-step workflow chains, and quality gates. Compose agentic workflows with an operator syntax; export as native skills to Claude Code, Cursor, OpenCode, and Gemini CLI.",
  "author": "minipuft",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "claude-prompts": "./dist/index.js",
    "cpm": "./dist/cpm.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "imports": {
    "#shared/*": "./src/shared/*",
    "#infra/*": "./src/infra/*",
    "#engine/*": "./src/engine/*",
    "#modules/*": "./src/modules/*",
    "#mcp/*": "./src/mcp/*",
    "#runtime/*": "./src/runtime/*",
    "#cli-shared/*": "./src/cli-shared/*"
  },
  "files": [
    "dist/index.js",
    "dist/cpm.js",
    "config.json",
    "resources",
    "hooks",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "npm run generate:contracts",
    "build": "node esbuild.config.mjs",
    "postbuild": "chmod +x dist/*.js || true",
    "build:prod": "NODE_ENV=production node esbuild.config.mjs",
    "build:watch": "node esbuild.config.mjs --watch",
    "build:tsc": "tsc --project tsconfig.json",
    "build:tsc:watch": "tsc --project tsconfig.json --watch",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "typecheck:tests": "tsc --noEmit --project tsconfig.test.json",
    "typecheck:tests:ratchet": "node scripts/typecheck-tests-ratchet.js check",
    "typecheck:tests:ratchet:baseline": "node scripts/typecheck-tests-ratchet.js update-baseline",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ratchet": "node scripts/eslint-ratchet.js check",
    "lint:ratchet:baseline": "node scripts/eslint-ratchet.js update-baseline",
    "lint:staged": "lint-staged",
    "lint:unused": "npx knip --reporter compact",
    "validate:format": "cd .. && git ls-files -- '*.json' '*.md' '*.yml' '*.yaml' ':!server/**' | xargs npx --prefix server prettier --check",
    "start": "node dist/index.js",
    "dev": "node esbuild.config.mjs --watch",
    "dev:tsc": "tsc --project tsconfig.json --watch & node --watch dist/index.js",
    "start:stdio": "node dist/index.js --transport=stdio",
    "start:quiet": "node dist/index.js --quiet",
    "start:verbose": "node dist/index.js --verbose",
    "start:debug": "node dist/index.js --debug-startup",
    "start:production": "node dist/index.js --quiet --transport=stdio",
    "start:development": "node dist/index.js --verbose --transport=streamable-http",
    "start:test": "node dist/index.js --startup-test",
    "verify:mcp": "node scripts/verify-mcp-surface.mjs",
    "capture:tool-schemas": "node scripts/capture-tool-schemas.mjs",
    "validate:tool-schemas": "node scripts/capture-tool-schemas.mjs --check",
    "verify:mcp:self-test": "node scripts/verify-mcp-surface.mjs --self-test",
    "help": "node dist/index.js --help",
    "test": "npm run pretest && npm run test:unit",
    "pretest": "npm run generate:contracts",
    "test:unit": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --runInBand tests/unit",
    "test:match": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --runInBand --testPathPatterns",
    "test:watch": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --watch tests/unit",
    "test:coverage": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --coverage tests/unit",
    "test:integration": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --runInBand tests/integration",
    "test:e2e": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --runInBand tests/e2e",
    "verify:claims": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --runInBand tests/e2e/claims-conformance.test.ts",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:ci": "npm run test:unit",
    "validate": "npm run test:ci",
    "validate:arch": "node scripts/validate-arch.js",
    "validate:arch:self-test": "node scripts/validate-arch.js --self-test",
    "validate:filesize": "node scripts/validate-filesize.js",
    "generate:contracts": "tsx scripts/generate-contracts.ts",
    "validate:contracts": "tsx scripts/generate-contracts.ts --check",
    "skills:export": "tsx scripts/skills-sync.ts export",
    "skills:diff": "tsx scripts/skills-sync.ts diff",
    "skills:pull": "tsx scripts/skills-sync.ts pull",
    "generate:schemas": "tsx scripts/generate-framework-schemas.ts",
    "validate:schemas": "tsx scripts/generate-framework-schemas.ts --check",
    "validate:config-schema": "tsx scripts/validate-config-schema.ts",
    "generate:gate-index": "node scripts/generate-gate-index.js",
    "validate:gate-index": "node scripts/generate-gate-index.js --check",
    "validate:frameworks": "tsx scripts/validate-frameworks.ts",
    "validate:readme": "node scripts/validate-readme.js --mode=block",
    "validate:conformance-coverage": "node scripts/validate-conformance-coverage.js",
    "validate:conformance-coverage:self-test": "node scripts/validate-conformance-coverage.js --self-test",
    "validate:versions": "node scripts/validate-versions.js",
    "typecheck:committed": "node scripts/typecheck-committed.js",
    "validate:operator-registry-drift": "node scripts/validate-operator-registry-drift.js",
    "validate:operator-registry-drift:self-test": "node scripts/validate-operator-registry-drift.js --self-test",
    "validate:plan-row-tracking": "node scripts/validate-plan-row-tracking.js",
    "validate:plan-row-tracking:self-test": "node scripts/validate-plan-row-tracking.js --self-test",
    "validate:no-legacy-sidecars": "node scripts/validate-no-legacy-sidecars.js",
    "validate:no-stepstate": "node scripts/validate-no-stepstate.js",
    "validate:no-methodology-vocab": "node scripts/validate-no-methodology-vocab.js",
    "validate:no-llm-client": "node scripts/validate-no-llm-client.js",
    "validate:no-llm-client:self-test": "node scripts/validate-no-llm-client.js --self-test",
    "validate:documented-options": "node scripts/validate-documented-options.js",
    "validate:required-contexts": "node scripts/validate-required-contexts.js",
    "validate:required-contexts:self-test": "node scripts/validate-required-contexts.js --self-test",
    "validate:package-entries": "node scripts/validate-package-entries.js",
    "validate:package-entries:self-test": "node scripts/validate-package-entries.js --self-test",
    "verify:package-artifact": "node scripts/verify-package-artifact.js",
    "verify:package-artifact:self-test": "node scripts/verify-package-artifact.js --self-test",
    "prepare:release-artifacts": "node scripts/prepare-release-artifacts.js",
    "prepare:release-artifacts:self-test": "node scripts/prepare-release-artifacts.js --self-test",
    "sync:versions": "node scripts/sync-versions.js",
    "version": "npm run sync:versions && git add ../package.json ../.release-please-manifest.json ../manifest.json ../.claude-plugin/plugin.json ../plugin.json ../server.json",
    "validate:extension-artifact": "node scripts/validate-extension-artifact.js",
    "validate:extension-artifact:self-test": "node scripts/validate-extension-artifact.js --self-test",
    "validate:github-action-pins": "node scripts/validate-github-action-pins.js",
    "validate:github-action-pins:self-test": "node scripts/validate-github-action-pins.js --self-test",
    "validate:release-workflow": "node scripts/validate-release-workflow.js",
    "validate:release-workflow:self-test": "node scripts/validate-release-workflow.js --self-test",
    "validate:downstream-lock-sync:self-test": "node scripts/synchronize-downstream-lock.js --self-test",
    "validate:standards-pins": "node scripts/validate-standards-pins.js",
    "validate:standards-pins:self-test": "node scripts/validate-standards-pins.js --self-test",
    "validate:renovate-preset-agreement": "node scripts/validate-renovate-preset-agreement.js",
    "validate:renovate-preset-agreement:self-test": "node scripts/validate-renovate-preset-agreement.js --self-test",
    "validate:renovate-extraction": "node scripts/validate-renovate-extraction.js",
    "validate:renovate-extraction:self-test": "node scripts/validate-renovate-extraction.js --self-test",
    "validate:push-scope:self-test": "node ../scripts/classify-validation-scope.js --self-test",
    "validate:python": "cd .. && ruff check hooks/ && ruff format --check hooks/ && pyrefly check --baseline hooks/.pyrefly-baseline.json && python3 -m pytest hooks/tests",
    "validate:all": "node scripts/run-validation-suite.js",
    "verify:action-metadata": "tsx scripts/verify-action-inventory.ts",
    "dev:graph": "madge --ts-config ./tsconfig.json --extensions ts src --image graph.svg",
    "dev:graph:json": "madge --ts-config ./tsconfig.json --extensions ts src --json",
    "prepack": "rsync -a --exclude='__pycache__' --exclude='*.pyc' ../hooks ./",
    "postpack": "rm -rf ./hooks",
    "prepublishOnly": "npm run build:prod",
    "release": "npm run build && npm test && npm publish --access public",
    "pack:mcpb": "../scripts/build-extension.sh",
    "pack:mcpb:validate": "npm --prefix .. run mcpb:validate",
    "validate:state-field-writers": "node scripts/validate-state-field-writers.js",
    "validate:state-field-writers:self-test": "node scripts/validate-state-field-writers.js --self-test",
    "validate:table-contracts": "tsx scripts/validate-table-contracts.ts",
    "validate:table-contracts:self-test": "tsx scripts/validate-table-contracts.ts --self-test",
    "validate:no-phantom-columns": "tsx scripts/validate-no-phantom-columns.ts",
    "validate:no-phantom-columns:self-test": "tsx scripts/validate-no-phantom-columns.ts --self-test",
    "validate:hooks-registered": "node ../scripts/validate-hook-registration.js",
    "hook-harness": "node ../scripts/hook-harness.mjs",
    "validate:hook-harness:self-test": "node ../scripts/hook-harness.mjs --self-test",
    "validate:suite-membership": "node scripts/validate-suite-membership.js",
    "validate:suite-membership:self-test": "node scripts/validate-suite-membership.js --self-test",
    "validate:hooks-registered:self-test": "node ../scripts/validate-hook-registration.js --self-test",
    "validate:agent-plugins": "node scripts/validate-agent-plugins.js",
    "validate:agent-plugins:self-test": "node scripts/validate-agent-plugins.js --self-test",
    "validate:db-claim-order": "node scripts/validate-db-claim-order.js",
    "validate:db-claim-order:self-test": "node scripts/validate-db-claim-order.js --self-test",
    "render:distributions": "node ../scripts/render-distributions.mjs",
    "validate:render-drift": "node ../scripts/render-distributions.mjs --check",
    "validate:render-drift:self-test": "node ../scripts/render-distributions.mjs --self-test",
    "plans:retire": "retire-done-plans --repo .. --apply",
    "plans:retire:check": "retire-done-plans --repo ..",
    "plans:retire:self-test": "retire-done-plans --repo .. --self-test"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs}": [
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minipuft/claude-prompts-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/minipuft/claude-prompts-mcp/issues"
  },
  "homepage": "https://github.com/minipuft/claude-prompts-mcp#readme",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "prompts",
    "prompt-templates",
    "prompt-management",
    "prompt-engineering",
    "claude",
    "claude-code",
    "workflow",
    "chains",
    "quality-gates",
    "skills",
    "ai"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.6.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-node": "^2.6.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "ajv": "^8.18.0",
    "chokidar": "^5.0.0",
    "diff": "^9.0.0",
    "express": "^5.2.1",
    "js-yaml": "^5.2.3",
    "nunjucks": "^3.2.4",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@minipuft/repository-standards-validation": "https://github.com/minipuft/repository-standards/archive/refs/tags/v1.3.0.tar.gz",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@types/nunjucks": "^3.2.6",
    "dependency-cruiser": "^18.1.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-sonarjs": "^4.0.2",
    "jest": "^30.3.0",
    "json5": "^2.2.3",
    "knip": "^6.31.0",
    "lint-staged": "^17.3.0",
    "madge": "^8.0.0",
    "prettier": "^3.7.4",
    "ts-jest": "^29.1.2",
    "ts-morph": "^27.0.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  }
}
