{
  "name": "claude-prompts",
  "version": "3.0.1",
  "description": "Claude Custom Prompts MCP Server",
  "author": "minipuft",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "claude-prompts": "./dist/index.js",
    "cpm": "./dist/cpm.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "imports": {
    "#shared/*": "./src/shared/*",
    "#infra/*": "./src/infra/*",
    "#engine/*": "./src/engine/*",
    "#modules/*": "./src/modules/*",
    "#mcp/*": "./src/mcp/*",
    "#runtime/*": "./src/runtime/*",
    "#cli-shared/*": "./src/cli-shared/*"
  },
  "files": [
    "dist",
    "config.json",
    "resources",
    "hooks",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "npm run generate:contracts",
    "build": "node esbuild.config.mjs",
    "postbuild": "chmod +x dist/*.js || true",
    "build:prod": "NODE_ENV=production node esbuild.config.mjs",
    "build:watch": "node esbuild.config.mjs --watch",
    "build:tsc": "tsc --project tsconfig.json",
    "build:tsc:watch": "tsc --project tsconfig.json --watch",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "typecheck:tests": "tsc --noEmit --project tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ratchet": "node scripts/eslint-ratchet.js check",
    "lint:ratchet:baseline": "node scripts/eslint-ratchet.js update-baseline",
    "lint:staged": "lint-staged",
    "lint:unused": "npx knip --reporter compact",
    "validate:format": "cd .. && git ls-files -- '*.json' '*.md' '*.yml' '*.yaml' ':!server/**' | xargs npx --prefix server prettier --check",
    "start": "node dist/index.js",
    "dev": "node esbuild.config.mjs --watch",
    "dev:tsc": "tsc --project tsconfig.json --watch & node --watch dist/index.js",
    "start:sse": "node dist/index.js --transport=sse",
    "start:stdio": "node dist/index.js --transport=stdio",
    "start:quiet": "node dist/index.js --quiet",
    "start:verbose": "node dist/index.js --verbose",
    "start:debug": "node dist/index.js --debug-startup",
    "start:production": "node dist/index.js --quiet --transport=stdio",
    "start:development": "node dist/index.js --verbose --transport=sse",
    "start:test": "node dist/index.js --startup-test",
    "verify:mcp": "node scripts/verify-mcp-surface.mjs",
    "verify:mcp:self-test": "node scripts/verify-mcp-surface.mjs --self-test",
    "help": "node dist/index.js --help",
    "test": "npm run pretest && npm run test:unit",
    "pretest": "npm run generate:contracts",
    "test:unit": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --runInBand tests/unit",
    "test:match": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --runInBand --testPathPatterns",
    "test:watch": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --watch tests/unit",
    "test:coverage": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --coverage tests/unit",
    "test:integration": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --runInBand tests/integration",
    "test:e2e": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --runInBand tests/e2e",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:ci": "npm run test:unit",
    "validate": "npm run test:ci",
    "validate:full": "npm run typecheck && npm run lint:ratchet && npm run test:all && npm run validate:all",
    "validate:arch": "depcruise --config .dependency-cruiser.cjs src",
    "validate:filesize": "node scripts/validate-filesize.js",
    "validate:metadata": "npm run verify:action-metadata",
    "validate:build": "npm run build && npm run start:test",
    "generate:contracts": "tsx scripts/generate-contracts.ts",
    "validate:contracts": "tsx scripts/generate-contracts.ts --check",
    "skills:export": "tsx scripts/skills-sync.ts export",
    "skills:diff": "tsx scripts/skills-sync.ts diff",
    "skills:pull": "tsx scripts/skills-sync.ts pull",
    "generate:schemas": "tsx scripts/generate-framework-schemas.ts",
    "generate:gate-index": "node scripts/generate-gate-index.js",
    "validate:gate-index": "node scripts/generate-gate-index.js --check",
    "validate:frameworks": "tsx scripts/validate-frameworks.ts",
    "validate:readme": "node scripts/validate-readme.js --mode=block",
    "validate:versions": "node scripts/validate-versions.js",
    "validate:no-legacy-sidecars": "node scripts/validate-no-legacy-sidecars.js",
    "validate:no-prompt-gates-alias": "node scripts/validate-no-prompt-gates-alias.js",
    "validate:no-tool-layer-validator-imports": "node scripts/validate-no-tool-layer-validator-imports.js",
    "validate:no-crosslayer-reexport": "node scripts/validate-no-crosslayer-reexport.js",
    "validate:no-chainsessionmanager": "node scripts/validate-no-chainsessionmanager.js",
    "validate:no-stepstate": "node scripts/validate-no-stepstate.js",
    "validate:no-methodology-vocab": "node scripts/validate-no-methodology-vocab.js",
    "validate:no-execution-mode": "node scripts/validate-no-execution-mode.js",
    "validate:no-crosslayer-relative": "node scripts/validate-no-crosslayer-relative.js",
    "validate:no-crosslayer-relative:self-test": "node scripts/validate-no-crosslayer-relative.js --self-test",
    "validate:documented-options": "node scripts/validate-documented-options.js",
    "validate:required-contexts": "node scripts/validate-required-contexts.js",
    "validate:required-contexts:self-test": "node scripts/validate-required-contexts.js --self-test",
    "validate:package-entries": "node scripts/validate-package-entries.js",
    "validate:package-entries:self-test": "node scripts/validate-package-entries.js --self-test",
    "sync:versions": "node scripts/sync-versions.js",
    "version": "npm run sync:versions && git add ../.release-please-manifest.json ../manifest.json ../.claude-plugin/plugin.json",
    "validate:dist-fresh": "bash scripts/validate-dist-fresh.sh",
    "validate:extension-deps": "node scripts/validate-extension-deps.js",
    "validate:python": "cd .. && ruff check hooks/ && ruff format --check hooks/ && pyrefly check --baseline hooks/.pyrefly-baseline.json",
    "validate:all": "npm run lint:ratchet && npm run validate:format && npm run validate:arch && npm run validate:filesize && npm run validate:metadata && npm run validate:contracts && npm run validate:python && npm run validate:frameworks && npm run validate:gate-index && npm run validate:versions && npm run validate:extension-deps && npm run validate:readme && npm run validate:no-legacy-sidecars && npm run validate:no-prompt-gates-alias && npm run validate:no-tool-layer-validator-imports && npm run validate:no-crosslayer-reexport && npm run validate:no-chainsessionmanager && npm run validate:no-stepstate && npm run validate:no-methodology-vocab && npm run validate:no-execution-mode && npm run validate:no-crosslayer-relative && npm run validate:documented-options && npm run validate:required-contexts && npm run validate:package-entries && npm run verify:mcp:self-test && npm run validate:required-contexts:self-test && npm run validate:package-entries:self-test && npm run validate:no-crosslayer-relative:self-test",
    "verify:action-metadata": "tsx scripts/verify-action-inventory.ts",
    "dev:graph": "madge --ts-config ./tsconfig.json --extensions ts src --image graph.svg",
    "dev:graph:json": "madge --ts-config ./tsconfig.json --extensions ts src --json",
    "prepack": "rsync -a --exclude='__pycache__' --exclude='*.pyc' ../hooks ./",
    "postpack": "rm -rf ./hooks",
    "prepublishOnly": "npm run build",
    "release": "npm run build && npm test && npm publish --access public",
    "pack:mcpb": "../scripts/build-extension.sh",
    "pack:mcpb:validate": "cd .. && npx @anthropic-ai/mcpb validate manifest.json"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs}": [
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minipuft/claude-prompts.git"
  },
  "bugs": {
    "url": "https://github.com/minipuft/claude-prompts/issues"
  },
  "homepage": "https://github.com/minipuft/claude-prompts#readme",
  "keywords": [
    "claude",
    "ai",
    "mcp",
    "model-context-protocol",
    "prompts",
    "language-model",
    "server"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.213.0",
    "@opentelemetry/resources": "^2.6.0",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@opentelemetry/sdk-trace-node": "^2.6.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "ajv": "^8.18.0",
    "chokidar": "^5.0.0",
    "diff": "^8.0.4",
    "express": "^5.2.1",
    "js-yaml": "^5.2.3",
    "nunjucks": "^3.2.4",
    "ulid": "^3.0.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/diff": "^8.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@types/nunjucks": "^3.2.6",
    "dependency-cruiser": "^18.1.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-sonarjs": "^4.0.2",
    "jest": "^30.3.0",
    "knip": "^6.31.0",
    "lint-staged": "^17.3.0",
    "madge": "^8.0.0",
    "prettier": "^3.7.4",
    "ts-jest": "^29.1.2",
    "ts-morph": "^27.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.53.0",
    "zod-to-json-schema": "^3.25.1"
  }
}
