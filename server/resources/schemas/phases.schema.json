{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "processingSteps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "frameworkBasis": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "required": {
            "type": "boolean"
          },
          "section_header": {
            "type": "string"
          },
          "guards": {
            "type": "object",
            "properties": {
              "required": {
                "type": "boolean"
              },
              "min_length": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "max_length": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "contains_any": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "contains_all": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "matches_pattern": {
                "type": "string"
              },
              "forbidden_terms": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "frameworkBasis",
          "order",
          "required"
        ]
      }
    },
    "executionSteps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "frameworkPhase": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected_output": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "action",
          "frameworkPhase",
          "expected_output"
        ]
      }
    },
    "templateEnhancements": {
      "type": "object",
      "properties": {
        "systemPromptAdditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "userPromptModifications": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contextualHints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "executionFlow": {
      "type": "object",
      "properties": {
        "preProcessingSteps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "postProcessingSteps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validationSteps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "qualityIndicators": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "executionTypeEnhancements": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "additionalProperties": {},
  "title": "Phases Definition",
  "description": "Schema for phases.yaml — defines processing steps, execution steps, assertions, and quality indicators for a framework."
}
