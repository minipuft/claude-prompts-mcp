{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+"
    },
    "enabled": {
      "type": "boolean"
    },
    "description": {
      "type": "string"
    },
    "gates": {
      "type": "object",
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "frameworkGates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "frameworkArea": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "validationCriteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    },
    "phasesFile": {
      "type": "string"
    },
    "judgePromptFile": {
      "type": "string"
    },
    "systemPromptGuidance": {
      "type": "string"
    },
    "toolDescriptions": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "templateSuggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "section": {
            "type": "string",
            "enum": [
              "system",
              "user"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "addition",
              "structure",
              "modification"
            ]
          },
          "description": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "frameworkJustification": {
            "type": "string"
          },
          "impact": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        },
        "required": [
          "section",
          "type"
        ]
      }
    }
  },
  "required": [
    "id",
    "name",
    "type",
    "version",
    "enabled"
  ],
  "additionalProperties": {},
  "title": "Framework Definition",
  "description": "Schema for framework.yaml — defines a framework with gates, guidance, and tool overlays."
}
