{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Prompt Authoring Draft",
  "description": "A complete prompt draft mapped to resource_manager action validate.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "systemMessage": {
      "type": "string",
      "minLength": 1
    },
    "userMessageTemplate": {
      "type": "string",
      "minLength": 1
    },
    "arguments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": ["string", "number", "boolean", "array", "object"]
          },
          "description": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "defaultValue": {},
          "validation": {
            "type": "object"
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    },
    "gateConfiguration": {
      "type": "object"
    },
    "chainSteps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "promptId": {
            "type": "string",
            "minLength": 1
          },
          "stepName": {
            "type": "string",
            "minLength": 1
          },
          "inputMapping": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "outputMapping": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "retries": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          }
        },
        "required": ["promptId", "stepName"],
        "additionalProperties": true
      }
    },
    "registerWithMcp": {
      "type": "boolean"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "runtime": {
            "type": "string",
            "enum": ["python", "node", "shell", "auto"]
          },
          "script": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "type": "string",
            "enum": ["schema_match", "explicit", "always", "never"]
          },
          "strict": {
            "type": "boolean"
          },
          "timeout": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "schema": {
            "type": "object"
          }
        },
        "required": ["id", "name", "script"],
        "additionalProperties": true
      }
    }
  },
  "required": ["id", "name", "category", "description"],
  "anyOf": [
    {
      "required": ["userMessageTemplate"]
    },
    {
      "required": ["systemMessage"]
    },
    {
      "required": ["chainSteps"]
    }
  ],
  "additionalProperties": false
}
