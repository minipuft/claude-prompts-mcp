{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "claude-prompts": {
      "type": "stdio",
      "command": "node",
      "args": ["${PLUGIN_ROOT}/server/dist/index.js", "--transport=stdio"],
      "env": {
        "MCP_WORKSPACE": "${PLUGIN_ROOT}",
        "MCP_RESOURCES_PATH": "${PLUGIN_ROOT}/server/resources",
        "MCP_RUNTIME_ROOT": "${PLUGIN_DATA}"
      }
    }
  }
}
